<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_header_gradiente"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AUTOMATIZACIÓN Y REGISTROS"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:textColor="#CCFBF1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅 Horarios e Historial"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Tarjeta crear horario -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_tarjeta"
                android:elevation="2dp"
                android:padding="18dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NUEVO HORARIO RECURRENTE"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:textColor="#64748B"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/etHoraHorario"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="Hora (ej. 08:30)"
                    android:inputType="time"
                    android:background="@drawable/bg_input"
                    android:layout_marginBottom="10dp" />

                <EditText
                    android:id="@+id/etDiasHorario"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="Días (ej. Lunes a Viernes)"
                    android:inputType="text"
                    android:background="@drawable/bg_input"
                    android:layout_marginBottom="10dp" />

                <Spinner
                    android:id="@+id/spPorcionHorario"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_input"
                    android:layout_marginBottom="14dp" />

                <Button
                    android:id="@+id/btnGuardarHorario"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="GUARDAR HORARIO"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_boton_primario" />
            </LinearLayout>

            <!-- Tarjeta horarios programados -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_tarjeta"
                android:elevation="2dp"
                android:padding="18dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HORARIOS (TOCA PARA ACTIVAR/PAUSAR)"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:textColor="#64748B"
                    android:layout_marginBottom="10dp" />

                <ListView
                    android:id="@+id/lvHorarios"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:divider="@android:color/transparent"
                    android:dividerHeight="8dp" />
            </LinearLayout>

            <!-- Tarjeta historial paginado con seguimiento total -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_tarjeta"
                android:elevation="2dp"
                android:padding="18dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HISTORIAL Y SEGUIMIENTO TOTAL"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:textColor="#64748B"
                    android:layout_marginBottom="8dp" />

                <!-- Banner de seguimiento total global -->
                <TextView
                    android:id="@+id/tvTotalHistorial"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Calculando totales..."
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#0F766E"
                    android:background="@drawable/bg_badge_estado"
                    android:layout_marginBottom="14dp" />

                <!-- Contenedor paginado (muestra máximo 5 por página) -->
                <LinearLayout
                    android:id="@+id/contenedorHistorial"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Controles de Paginación -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/btnAnterior"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="◀ Anterior"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#0F766E"
                        android:background="@drawable/bg_boton_outline"
                        android:enabled="false" />

                    <TextView
                        android:id="@+id/tvPaginaActual"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pág. 1 de 1"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#334155"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp" />

                    <Button
                        android:id="@+id/btnSiguiente"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="Siguiente ▶"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#0F766E"
                        android:background="@drawable/bg_boton_outline"
                        android:enabled="false" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnVolverHorarios"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Volver al Panel Principal"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_boton_secundario" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>